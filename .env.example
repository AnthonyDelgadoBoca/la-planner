# Choose one shared password for the website
SITE_PASSWORD=change-this-to-your-own-long-password
# Random secret used to sign login sessions (32+ random characters)
SESSION_SECRET=replace-with-a-long-random-secret
# Supabase project settings (keep service role key server-side only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
